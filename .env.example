# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Run `pnpm db:up` to start it.
DATABASE_URL=postgres://salo:salo@localhost:5432/salo

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# --- AI ---------------------------------------------------------------------
# Provider is swappable without code changes: openrouter | anthropic | openai
AI_PROVIDER=openrouter

# Leave blank to use the provider's default model chosen in server/ai/provider.ts.
# For OpenRouter that default is `~anthropic/claude-sonnet-latest` — a "latest
# alias" that tracks the current model in that family, so it does not go stale.
# Any slug from openrouter.ai/models works; the model must support tool calling.
AI_MODEL=

# Get one at openrouter.ai/keys. This is the only AI key you need unless you
# switch AI_PROVIDER to a direct provider below.
OPENROUTER_API_KEY=

# Only needed if AI_PROVIDER is set to one of these. A ChatGPT Plus or Claude
# subscription does NOT include API access — these are separate, metered keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier guard rail (PRD §12). Per user, per day.
AI_DAILY_MESSAGE_LIMIT=25
