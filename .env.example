# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Run `pnpm db:up` to start it.
DATABASE_URL=postgres://salo:salo@localhost:5432/salo

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# --- AI ---------------------------------------------------------------------
# Provider is swappable without code changes: anthropic | openai
AI_PROVIDER=anthropic
# Leave blank to use the provider's default model chosen in server/ai/provider.ts
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier guard rail (PRD §12). Per user, per day.
AI_DAILY_MESSAGE_LIMIT=25
